{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode: o Vite faz o bundle, o tsc só checa tipos. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias "@/..." para evitar imports relativos frágeis ("../../../"). */
    "paths": { "@/*": ["./src/*"] },

    /* Rigor de tipos.
       "strict" é o pacote essencial (noImplicitAny, strictNullChecks, ...).
       As flags abaixo pegam bugs reais que "strict" sozinho deixa passar. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    /* Faz `array[i]` ser `T | undefined`. Evita a classe de bug mais comum
       em listas vindas de API: assumir que um índice sempre existe. */
    "noUncheckedIndexedAccess": true
  },
  "include": ["src"]
}
