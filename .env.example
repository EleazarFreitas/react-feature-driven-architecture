# ---------------------------------------------------------------------------
# Exemplo de configuração. Copie para `.env` se quiser sobrescrever os valores
# padrão de `.env.development` / `.env.production`.
#
#   cp .env.example .env
#
# ATENÇÃO: tudo que começa com VITE_ é EMBUTIDO NO BUNDLE JavaScript enviado ao
# navegador. Qualquer pessoa consegue ler abrindo o DevTools. Portanto aqui vai
# somente CONFIGURAÇÃO PÚBLICA — nunca senha, API secret, private key ou
# credencial de banco. Veja docs.md > Segurança.
# ---------------------------------------------------------------------------

# URL base da API (DummyJSON). Sem barra no final.
VITE_API_BASE_URL=https://dummyjson.com

# Validade do access token pedida ao /auth/login, em minutos.
# A DummyJSON aceita esse parâmetro, o que nos permite demonstrar expiração de
# sessão e refresh de token de verdade. Use um valor baixo (ex.: 1) para ver o
# fluxo de refresh acontecendo.
VITE_ACCESS_TOKEN_TTL_MINUTES=30

# Liga os logs de debug no console (logger.debug). "true" ou "false".
VITE_ENABLE_DEBUG_LOGS=false

# URL base da API de upload de arquivos (Platzi Fake Store). Sem barra no final.
# Serviço separado porque a DummyJSON não aceita upload de arquivo — ver docs.md.
VITE_UPLOAD_API_BASE_URL=https://api.escuelajs.co/api/v1
